DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,10.0.2.2

# Either specify DATABASE_URL (for Cloud PostgreSQL providers such as Render, Railway, Neon, Supabase):
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Or specify individual parameters for local PostgreSQL:
DB_NAME=bank_employee_details
DB_USER=postgres
DB_PASSWORD=replace-with-your-postgresql-password
DB_HOST=127.0.0.1
DB_PORT=5432

# CORS whitelist (comma separated):
CORS_ALLOWED_ORIGINS=https://ramdenimanojkumar.github.io,http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_ALL_ORIGINS=true
